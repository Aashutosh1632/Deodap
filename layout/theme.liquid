      {% if template contains 'product' %}
      <script>
         (function() {
           function applyHideLogic() {
             const container = document.querySelector('.whatmore-widget-container');
             if (!container) return;
             const tiles = container.querySelectorAll('.whatmore-event-tile-horizontal-swipe-animation-next');
             const root = container.closest('.whatmore-base') || container.closest('[class*="whatmore"]') || container;
             if (tiles.length < 2) {
               root.style.setProperty('display', 'none', 'important');
             } else {
               root.style.removeProperty('display');
             }
           }
           function init() {
             const observer = new MutationObserver(() => {
               const container = document.querySelector('.whatmore-widget-container');
               if (container) {
                 applyHideLogic();
                 const innerObserver = new MutationObserver(applyHideLogic);
                 innerObserver.observe(container, {
                   childList: true,
                   subtree: true,
                   attributes: true
                 });
                 observer.disconnect(); 
               }
             });
             observer.observe(document.body, { childList: true, subtree: true });
             applyHideLogic();
           }
         
           if (document.readyState === 'loading') {
             document.addEventListener('DOMContentLoaded', init);
           } else {
             init();
           }
         })();
      </script>
