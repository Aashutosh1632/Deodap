      window.uetq.push('set', { 'pid': {
        'em': '{{ customer.email | downcase | sha256 }}',
        'ph': '{{ customer.default_address.phone }}'
      }});

      function _loadBingUET() {
        if (window._uetLoaded) return;
        window._uetLoaded = true;
        var s = document.createElement('script');
        s.src = '{{ "microsoft-ads.js" | asset_url }}';
        s.async = true;
        document.head.appendChild(s);
      }

      ['scroll','click','touchstart'].forEach(function(evt) {
        window.addEventListener(evt, _loadBingUET, {once: true, passive: true});
      });
      setTimeout(_loadBingUET, 4000);
    </script>
