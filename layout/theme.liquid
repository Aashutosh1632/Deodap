      <script>
         document.addEventListener('DOMContentLoaded', function () {
           function tryClickFirstWhatmoreCard(retries = 10) {
             const stacks = document.querySelectorAll('.whatmore-carousel-events-feed > .chakra-stack > .chakra-stack');
             if (stacks.length > 0) {
               const firstStack = stacks[0];
               const clickable = firstStack.querySelector('.whatmore-event-tile-scale-out-animation');
               if (clickable) {
                 clickable.click(); 
                 console.log('Clicked the first whatmore tile.');
                 return;
               }
             }
             if (retries > 0) {
               setTimeout(() => tryClickFirstWhatmoreCard(retries - 1), 200);
             } else {
               console.warn('Failed to find Whatmore card to click.');
             }
           }
           tryClickFirstWhatmoreCard();
         });
      </script>
      <script>
         document.addEventListener("DOMContentLoaded", function () {
          function attachScopedCloseRedirect(retries = 15) {
            const containers = document.querySelectorAll('.chakra-stack div[class*="whatmore-css-sv-"]');
            let attached = false;
            containers.forEach(container => {
              const closeIcon = container.querySelector('[data-testid="CloseRoundedIcon"]');
              if (closeIcon) {
                const clickable = closeIcon.closest('button, div');
                if (clickable && !clickable.dataset.redirectAttached) {
                  clickable.dataset.redirectAttached = "true";
                  clickable.addEventListener("click", function (e) {
                    e.stopPropagation();
                    const prevURL = localStorage.getItem('previous_collection_url');
                    if (prevURL) {
                      localStorage.removeItem('previous_collection_url'); 
                      window.location.href = prevURL;
                    } else {
                      window.location.href = "/";
                    }
                  });
                  attached = true;
                }
              }
            });
            if (!attached && retries > 0) {
              setTimeout(() => attachScopedCloseRedirect(retries - 1), 1000);
            } else if (!attached) {
              console.warn("⚠️ No Whatmore close buttons found to bind.");
            }
          }
          attachScopedCloseRedirect();
         });
      </script>
