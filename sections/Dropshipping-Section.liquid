
{{ 'dropshipping-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      order: {{ section.settings.order_no }};
    }
  }
{%- endstyle -%}

<div class="dropshipping-section page-width">
  <div class="dropshipping-section__bottom-row">
    <div class="dropshipping-section__small-images">
      {%- assign image_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'small_image' -%}
          {%- if block.settings.image_desktop or block.settings.image_mobile -%}
            {%- assign image_count = image_count | plus: 1 -%}
            {%- if image_count <= 2 -%}
              {%- assign img_alt = 'Image ' | append: forloop.index -%}
              <a href="{{ block.settings.link | default: '#' }}" class="dropshipping-section__block {{ block.settings.custom_class }}">
                {%- if block.settings.image_desktop -%}
                  {{ block.settings.image_desktop | image_url: width: 700 | image_tag:
                    class: 'dropshipping-section__large-image-desktop',
                    alt: img_alt,
                    loading: 'lazy',
                    widths: '430, 535, 650, 700',
                    sizes: '(min-width: 1400px) 650px, (min-width: 750px) calc(100vw - 130px), 100vw'
                  }}
                {%- endif -%}
                {%- if block.settings.image_mobile -%}
                  {{ block.settings.image_mobile | image_url: width: 430 | image_tag:
                    class: 'dropshipping-section__large-image-mobile',
                    alt: img_alt,
                    loading: 'lazy',
                    widths: '375, 430, 535',
                    sizes: '100vw'
                  }}
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="dropshipping-section__text">
      <h2 class="dropshipping-section__heading"><strong>{{ section.settings.heading_text }}</strong></h2>
      {%- if section.settings.button_text and section.settings.button_link -%}
        <a href="{{ section.settings.button_link }}" class="dropshipping-section__button">{{ section.settings.button_text }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dropshipping-section",
  "settings": [
    { "type": "text", "id": "order_no", "label": "Order Number" },
    { "type": "text", "id": "heading_text", "label": "Heading Text", "default": "START DEODAP WHOLESALE MALL IN YOUR CITY" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Learn More" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "blocks": [
    {
      "type": "small_image",
      "name": "Small Image",
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "Desktop Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile Image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "custom_class", "label": "Custom CSS Class", "info": "Add a custom class for this block" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Dropshipping-Section" }]
}
{% endschema %}
