{{ 'New-imge-text.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'New-imge-text.js' | asset_url }}" defer="defer"></script>

<div class="NEWW-im-tx {{ section.settings.dif_class }} page-width">
  <div
    class="{{ section.settings.section_id }} image-with-text"
  >
    {% if section.settings.heading != blank %}
      <h2 class="NEWW-im-tx-h2">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <div class="NEWW-im-tx-p">{{ section.settings.subheading }}</div>
    {% endif %}
    <div class="NEW-image-texts">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'multiple-images' %}
            <div class="mul-img-{{ forloop.index }}-{{ forloop.index }} {{ block.settings.text_alignment }}">
              {% for i in (1..4) %}
                {% assign image_key = 'image' | append: i %}
                {% assign image = block.settings[image_key] %}
                {% assign width_key = 'img_width' | append: i %}
                {% assign img_width = block.settings[width_key] %}
                {% assign text_key = 'text' | append: i %}
                {% assign text = block.settings[text_key] %}
                {% assign text_key = 'textss' | append: i %}
                {% assign textss = block.settings[text_key] %}
                <div class="img-ml-txt">
                  {% if image != blank %}
                    <div class="ml-im" style="width: {{ img_width }}%;">
                      <img src="{{ image | img_url: '' }}" class="mul-im">
                    </div>
                    <div class="ml-txttt">
                      <p
                        style="font-size: {{ block.settings.t1size}}px;"
                      >
                        {{ text }}
                      </p>
                      <div
                        class="add-t"
                        style="font-size: {{ block.settings.d1size }}px;"
                      >
                        {{ textss }}
                      </div>
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
              {% if block.settings.btn_txtt != blank %}
                <div class="Mewmult-BT">
                  <a class="Mewmult-btns anim_btn" href="#{{ block.settings.btn_id }}">{{ block.settings.btn_txtt }}</a>
                </div>
                <script>
                                      document.querySelectorAll('.Mewmult-btns').forEach(button => {
                    button.addEventListener('click', function (e) {
                      e.preventDefault();
                      const targetId = this.getAttribute('href').substring(1);
                      const targetElement = document.getElementById(targetId);
                      if (targetElement) {
                        targetElement.scrollIntoView({ behavior: 'smooth' });
                      }
                    });
                  });
                </script>
              {% endif %}
            </div>
          {% when 'image' %}
            <div class="single-image">
              {% if block.settings.image != blank %}
                <a href="#{{ block.settings.ihref }}">
                  <img src="{{ block.settings.image | img_url: '' }}" class="sing-img desknogp ">
                  <img src="{{ block.settings.mb_image | img_url: '' }}" class="sing-img mobnogp">
                </a>
             
              {% endif %}
            </div>
          {% when 'text' %}
            <div
              class="custom-text-blc {{ block.settings.text_alignment }}"
              style="width: {{ block.settings.width-tx }}%; margin: 0 auto;"
            >
              {% if block.settings.image_txt != blank %}
                <img src="{{ block.settings.image-txt | img_url: '' }}" class="img-tx">
              {% endif %}
              {% if block.settings.heading != blank %}
                <h2 class="cst-it-h2">{{ block.settings.heading }}</h2>
              {% endif %}

              {% if block.settings.content != blank %}
                <p class="cst-it-p">{{ block.settings.content }}</p>
              {% endif %}

              {% if block.settings.btn_text != blank %}
                <a href="{{ block.settings.btn_url }}">{{ block.settings.btn_text }}</a>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>


<style>
    @keyframes shake_msg {
    0% { transform: translateX(0); }
    20% { transform: translateX(-15px); }
    40% { transform: translateX(15px); }
    60% { transform: translateX(-15px); }
    80% { transform: translateX(15px); }
    100% { transform: translateX(0); }
  }

  .anim_btn.shake_msg {
    animation: shake_msg 0.5s ease; /* Adjusted for a quick shake_msg */
  }
</style>
